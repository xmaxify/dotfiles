[core]
    editor = nvim
    autocrlf = input

[merge]
    tool = diffview

[mergetool]
    keepBackup = false
    keepTemporaries = false

[mergetool "diffview"]
    cmd = nvim -c "DiffviewOpen" "$MERGED"
    trustExitCode = true

[rebase]
    autoStash = true

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[include]
    path = ~/.gitconfig-local
