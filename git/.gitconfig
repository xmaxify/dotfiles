[core]
  editor = nvim
  autocrlf = input
  excludesfile = ~/.gitignore_global

[merge]
  tool = diffview

[mergetool]
  keepBackup = false
  keepTemporaries = false

[mergetool "diffview"]
  cmd = nvim -c "DiffviewOpen" "$MERGED"
  trustExitCode = true

[fetch]
  prune = true

[rebase]
  autoStash = true

[pull]
  rebase = true

[push]
  autoSetupRemote = true

[include]
  path = ~/.gitconfig-local
